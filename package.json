{
  "name": "mergescape",
  "version": "0.0.0",
  "private": true,
  "description": "A browser idle RPG whose experience comes only from your real pull-request activity on GitHub.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.18.0"
